# StrikerAPI
STRIKER_API_KEY=your_striker_api_key
STRIKER_BASE_URL=https://mcp.strikerapi.com

# BallDontLie API
BALLDONTLIE_API_KEY=your_balldontlie_api_key
BALLDONTLIE_BASE_URL=https://api.balldontlie.io

# API-Football
API_FOOTBALL_KEY=your_api_football_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Supabase Public (used by frontend)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Direct Connection / Service Role (used by ingestion runner)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
